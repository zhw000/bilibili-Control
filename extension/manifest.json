{
  "manifest_version":3,"name":"哔哩遥控 · Bili Remote","version":"0.5.1","description":"让已配对的 iPhone 和 Apple Watch 控制这台电脑上的哔哩哔哩网页。",
  "minimum_chrome_version":"116",
  "key":"",
  "permissions":["nativeMessaging","storage","alarms","cookies"],
  "host_permissions":["https://www.bilibili.com/*","https://space.bilibili.com/*","https://search.bilibili.com/*","https://api.bilibili.com/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_title":"哔哩遥控","default_popup":"popup.html"},
  "content_scripts":[{"matches":["https://www.bilibili.com/*","https://space.bilibili.com/*","https://search.bilibili.com/*"],"js":["content.js"],"run_at":"document_start"}]
}
